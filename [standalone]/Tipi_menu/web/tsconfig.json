{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@tipi-rankings/*": ["../../Tipi_Rankings/web/src/*"],
      "@uls-lb/*": ["../../Tipi_Rankings/web/src/*"],
      "@/*": ["../../Tipi_Rankings/web/src/*"],
      "@tipi-daily-rewards/*": ["../Tipi_Daily_Rewards/web/src/*"]
    }
  },
  "include": ["src", "../../Tipi_Rankings/web/src", "../../Tipi_Daily_Rewards/web/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
