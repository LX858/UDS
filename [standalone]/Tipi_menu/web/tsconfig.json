{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@tipi-rankings/*": [
        "./vendor/Tipi_Rankings/web/src/*"
      ],
      "@uls-lb/*": [
        "./vendor/Tipi_Rankings/web/src/*"
      ],
      "@/*": [
        "./vendor/Tipi_Rankings/web/src/*"
      ],
      "@tipi-daily-rewards/*": [
        "./vendor/Tipi_Daily_Rewards/web/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vendor/Tipi_Rankings/web/src",
    "vendor/Tipi_Daily_Rewards/web/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
